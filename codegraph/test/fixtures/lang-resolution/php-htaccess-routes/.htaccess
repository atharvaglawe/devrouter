RewriteEngine On

# Map /trf to transfer.php (cmadserving-style URL alias)
RewriteCond %{REQUEST_URI}?%{QUERY_STRING} ^/trf\?(.*)
RewriteRule ^(.*)$ /transfer.php?%1 [L]

# Healthcheck endpoint
RewriteCond %{REQUEST_URI} ^/healthz$
RewriteRule ^(.*)$ /health.php [L]

# Ads endpoint
RewriteCond %{REQUEST_URI} ^/ads$
RewriteRule ^(.*)$ /ads.php [L]

# External redirect — should be ignored by the extractor
RewriteCond %{REQUEST_URI} ^/old$
RewriteRule ^(.*)$ https://elsewhere.example.com/new [R=301,L]

# Static asset rewrite — should be ignored
RewriteCond %{REQUEST_URI} ^/main\.js$
RewriteRule ^(.*)$ /static/main.js [L]
