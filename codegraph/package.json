{
  "name": "@devrouter/codegraph",
  "version": "1.5.3-devrouter.0",
  "private": true,
  "description": "Codegraph: slim graph-engine for devrouter. Forked from gitnexus with UI/wiki/group/MCP layers stripped; only the parser, ingestion pipeline, search/query, local LadybugDB, and the HTTP endpoints devrouter consumes are kept.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "bin": {
    "codegraph": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "vendor"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "serve": "tsx src/cli/index.ts serve",
    "dev": "tsx watch src/cli/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@ladybugdb/core": "^0.16.1",
    "@scarf/scarf": "^1.4.0",
    "cli-progress": "^3.12.0",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "glob": "^11.0.0",
    "graphology": "^0.25.4",
    "graphology-indices": "^0.17.0",
    "graphology-utils": "^2.3.0",
    "ignore": "^7.0.5",
    "js-yaml": "^4.1.1",
    "lru-cache": "^11.0.0",
    "mnemonist": "^0.39.0",
    "onnxruntime-node": "^1.24.0",
    "pandemonium": "^2.4.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c": "0.23.2",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.23.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.23.0",
    "tree-sitter-php": "^0.23.0",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "uuid": "^13.0.0"
  },
  "optionalDependencies": {
    "tree-sitter-dart": "github:UserNobody14/tree-sitter-dart#80e23c07b64494f7e21090bb3450223ef0b192f4",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-swift": "^0.6.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "graphology-types": "^0.24.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@huggingface/transformers": {
      "onnxruntime-node": "$onnxruntime-node"
    },
    "tree-sitter-c": "0.23.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
